# Configurações de Ambiente (development, test, production)
APP_ENV=development

# Chave secreta para criptografia de tokens JWT (substituir em produção)
SECRET_KEY=super_chave_secreta_para_desenvolvimento_local_12345

# URL do Banco de Dados
# SQLite Local:
DATABASE_URL=sqlite:///data/dev.db
# Para Produção Docker/EasyPanel:
# DATABASE_URL=sqlite:////app/data/prod.db
# Para PostgreSQL (se desejar migrar):
# DATABASE_URL=postgresql://usuario:senha@host:5432/print3d_db

# Porta de execução
PORT=8000
